# Copy to .env and fill in the keys for the providers you use.
# Only the provider you run needs a key.

# Default provider and report language (can be overridden with --provider / --lang)
CHATLENS_PROVIDER=deepseek
CHATLENS_LANG=en
# CHATLENS_TIMEZONE=Europe/Kyiv

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Local models via Ollama / LM Studio need no key
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:14b
